<script>
// Place this script on EVERY page of your site
document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const hasUTMs = urlParams.has('utm_source') || urlParams.has('utm_medium') || urlParams.has('utm_campaign');

    // 1. If URL has UTM parameters → save/overwrite them
    if (hasUTMs) {
        const utmParams = {
            utm_source: urlParams.get('utm_source'),
            utm_medium: urlParams.get('utm_medium'),
            utm_campaign: urlParams.get('utm_campaign'),
            utm_content: urlParams.get('utm_content'),
            utm_term: urlParams.get('utm_term'),
            timestamp: new Date().getTime()
        };
        localStorage.setItem('utmParams', JSON.stringify(utmParams));
    } else {
        // 2. If no UTMs in URL → clear stored UTMs
        localStorage.removeItem('utmParams');
    }

    // 3. Apply stored UTMs to links if they exist
    const storedUTMs = localStorage.getItem('utmParams');
    if (storedUTMs) {
        const utms = JSON.parse(storedUTMs);
        document.querySelectorAll('a[href*="visitcloud.com"]').forEach(function(link) {
            try {
                const url = new URL(link.href);
                Object.keys(utms).forEach(key => {
                    if (key !== 'timestamp' && utms[key]) {
                        url.searchParams.set(key, utms[key]);
                    }
                });
                link.href = url.toString();
            } catch (e) {
                console.error('Error updating link:', e);
            }
        });
    }
});
</script>


