    <div class="container google-translate-container">
        <div id="google_translate_element"></div>
    </div>

    <script>
        function setCookie(name, value, days) {
            let expires = "";
            if (days) {
                let date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        function getCookie(name) {
            let nameEQ = name + "=";
            let ca = document.cookie.split(';');
            for(let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) === ' ') c = c.substring(1);
                if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }

        function googleTranslateElementInit() {
            //let lang = getCookie('googtrans') || 'en'; // Default to English if no cookie
              let lang =  'en';
            // Change language to German if the page title matches "testg"
            if ("404 Error Page".toLowerCase() === "testg") {
                lang = 'de';
            }
              else{lang = 'en';}
            //console.log('Selected language:', lang); // Debugging line

            // Set Google Translate cookie to prefer the selected language
            setCookie('googtrans', '/' + lang, 1);

            // Initialize the Google Translate element
            new google.translate.TranslateElement({
                pageLanguage: 'en', // Page language is set to English, but we force the translation
                includedLanguages: 'it,de,fr,es,nl,en,pl,tr',
                layout: google.translate.TranslateElement.InlineLayout.NONE
            }, 'google_translate_element');
        }

        // Load Google Translate script
        (function() {
            var script = document.createElement('script');
            script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
            script.type = 'text/javascript';
            document.head.appendChild(script);
        })();
    </script>


